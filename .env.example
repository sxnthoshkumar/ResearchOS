# Autonomous AI Research Assistant Configuration

# Application Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# LLM Provider Configuration
# Options: ollama, demo, openai, generic
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=90

# Local Ollama Configuration (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Hosted OpenAI Configuration (optional fallback)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Research Sources & Adapters Configuration
# Provide an email address for the OpenAlex polite pool
OPENALEX_EMAIL=researcher@example.org
MAX_SOURCES_PER_QUERY=10
SEARCH_TIMEOUT_SECONDS=25

# Database Configuration
DATABASE_PATH=data/research_assistant.db

# Storage / Export Configuration
EXPORT_DIR=exports
